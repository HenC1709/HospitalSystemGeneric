<UserControl
    x:Class="HospitalSystem.Desktop.Views.ResumenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,0">
            <!-- Tarjeta de Conexión e Inicialización de MySQL -->
            <Border Style="{StaticResource HospitalHoverCardStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource HospitalPrimarySoftBrush}" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Database24" Foreground="{StaticResource HospitalPrimaryBrush}" />
                        </Border>
                        <TextBlock
                            Text="Laboratorio de Conexión MySQL"
                            FontSize="15"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource HospitalTextPrimaryBrush}" />
                        <TextBlock Text="  ·  " VerticalAlignment="Center" Foreground="{StaticResource HospitalTextMutedBrush}" />
                        <TextBlock
                            Text="{Binding OrigenDatosTexto}"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource HospitalTealBrush}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            PlaceholderText="Server=localhost;Port=3306;Database=hospital_system_db;Uid=root;Pwd=;"
                            Text="{Binding CadenaConexion, UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Style="{StaticResource HospitalSecondaryButtonStyle}"
                            Command="{Binding ProbarConexionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PlugConnected20" Margin="0,0,6,0" />
                                <TextBlock Text="Probar Conexión" />
                            </StackPanel>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Style="{StaticResource HospitalPrimaryButtonStyle}"
                            Command="{Binding InicializarBaseDatosMySqlCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DatabaseArrowUp20" Margin="0,0,6,0" />
                                <TextBlock Text="Inicializar BD (Schema + Seed)" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- 4 Tarjetas KPI Hospitalarias con Elevación en Hover -->
            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource HospitalHoverCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="CAMAS DISPONIBLES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HospitalTextMutedBrush}" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="{StaticResource HospitalTealSoftBrush}">
                                <ui:SymbolIcon Symbol="Bed24" Foreground="{StaticResource HospitalTealBrush}" />
                            </Border>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <TextBlock Text="{Binding CamasDisponibles}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource HospitalTealBrush}" />
                            <TextBlock Text=" / " FontSize="20" Foreground="{StaticResource HospitalTextMutedBrush}" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding CamasTotales}" FontSize="18" Foreground="{StaticResource HospitalTextMutedBrush}" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="Camas habilitadas sin ocupar" FontSize="12" Foreground="{StaticResource HospitalTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HospitalHoverCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="CANTIDAD DE SALAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HospitalTextMutedBrush}" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="{StaticResource HospitalPrimarySoftBrush}">
                                <ui:SymbolIcon Symbol="BuildingMultiple24" Foreground="{StaticResource HospitalPrimaryBrush}" />
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding CantidadSalas}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource HospitalPrimaryBrush}" Margin="0,8,0,4" />
                        <TextBlock Text="Pabellones clínicos activos" FontSize="12" Foreground="{StaticResource HospitalTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HospitalHoverCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="MÉDICOS DEL DÍA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HospitalTextMutedBrush}" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="{StaticResource HospitalSuccessSoftBrush}">
                                <ui:SymbolIcon Symbol="Stethoscope24" Foreground="{StaticResource HospitalSuccessBrush}" />
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding MedicosDelDiaCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource HospitalSuccessBrush}" Margin="0,8,0,4" />
                        <TextBlock Text="Especialistas en guardia hoy" FontSize="12" Foreground="{StaticResource HospitalTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HospitalHoverCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="SALIDAS A LABORATORIO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HospitalTextMutedBrush}" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="{StaticResource HospitalWarningSoftBrush}">
                                <ui:SymbolIcon Symbol="Beaker24" Foreground="{StaticResource HospitalWarningBrush}" />
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding SalidasLabActivasCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource HospitalWarningBrush}" Margin="0,8,0,4" />
                        <TextBlock Text="Pacientes con estudios activos" FontSize="12" Foreground="{StaticResource HospitalTextMutedBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Tablas Clínicas de Salas y Médicos del Día -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource HospitalHoverCardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock
                            Text="Capacidad y Ocupación por Sala"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="{StaticResource HospitalTextPrimaryBrush}"
                            Margin="0,0,0,10" />
                        <DataGrid
                            ItemsSource="{Binding Salas}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            HeadersVisibility="Column"
                            MinHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80" />
                                <DataGridTextColumn Header="Sala Clínica" Binding="{Binding Nombre}" Width="*" />
                                <DataGridTextColumn Header="Piso" Binding="{Binding Piso}" Width="50" />
                                <DataGridTemplateColumn Header="Ocupación" Width="195">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,2">
                                                <TextBlock Text="{Binding ResumenCapacidad}" FontSize="11" Foreground="{StaticResource HospitalTextPrimaryBrush}" />
                                                <ProgressBar
                                                    Height="6"
                                                    Margin="0,3,0,0"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Foreground="{StaticResource HospitalTealBrush}"
                                                    Value="{Binding PorcentajeOcupacion, Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource HospitalHoverCardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock
                            Text="Médicos del Día en Guardia Activa"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="{StaticResource HospitalTextPrimaryBrush}"
                            Margin="0,0,0,10" />
                        <DataGrid
                            ItemsSource="{Binding MedicosDelDia}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            HeadersVisibility="Column"
                            MinHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Especialista" Binding="{Binding Nombres}" Width="*" />
                                <DataGridTextColumn Header="Especialidad" Binding="{Binding Especialidad}" Width="145" />
                                <DataGridTemplateColumn Header="Estado" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource HospitalSuccessSoftBrush}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="Guardia Hoy" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HospitalSuccessBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ubicación" Binding="{Binding Consultorio}" Width="125" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
