<ui:FluentWindow
    x:Class="HospitalSystem.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:HospitalSystem.Desktop.Views"
    Title="HospitalSystem — Gestión Clínica y Pruebas MySQL"
    Width="1360"
    Height="840"
    MinWidth="1100"
    MinHeight="700"
    Background="{StaticResource HospitalBgBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource HospitalBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Nativa -->
        <ui:TitleBar
            Grid.Row="0"
            Title="Hospital Central Metropolitano San Lucas — Sistema Clínico (.NET 10 · C# 14 · MySQL)" />

        <!-- NAVBAR HOSPITALARIO SUPERIOR -->
        <Border
            Grid.Row="1"
            Background="{StaticResource HospitalNavbarBrush}"
            BorderBrush="{StaticResource HospitalBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Identidad Visual del Hospital -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border
                        Width="38"
                        Height="38"
                        CornerRadius="10"
                        Background="{StaticResource HospitalPrimaryBrush}"
                        Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="HeartPulse24" Foreground="White" FontSize="20" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Text="HOSPITAL SAN LUCAS"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource HospitalTextPrimaryBrush}" />
                        <TextBlock
                            Text="Gestión Clínica &amp; MySQL Lab"
                            FontSize="11"
                            Foreground="{StaticResource HospitalTextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Pestañas de Navegación Centrales con Hover y Subrayado Activo -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <RadioButton
                        Style="{StaticResource HospitalNavTabButtonStyle}"
                        IsChecked="{Binding EsVistaResumen, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" Margin="0,0,6,0" />
                            <TextBlock Text="Resumen General" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Style="{StaticResource HospitalNavTabButtonStyle}"
                        IsChecked="{Binding EsVistaPacientes, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" Margin="0,0,6,0" />
                            <TextBlock Text="Menú Pacientes" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Style="{StaticResource HospitalNavTabButtonStyle}"
                        IsChecked="{Binding EsVistaMedicos, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Stethoscope24" Margin="0,0,6,0" />
                            <TextBlock Text="Menú Médicos" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Style="{StaticResource HospitalNavTabButtonStyle}"
                        IsChecked="{Binding EsVistaLaboratorios, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Beaker24" Margin="0,0,6,0" />
                            <TextBlock Text="Salidas a Laboratorio" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Píldoras KPI en Vivo + Estado MySQL + Botón Actualizar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource HospitalTealSoftBrush}" CornerRadius="14" Padding="10,5" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Camas: " FontSize="12" Foreground="#0F766E" />
                            <TextBlock Text="{Binding CamasDisponibles}" FontSize="12" FontWeight="Bold" Foreground="#0F766E" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource HospitalPrimarySoftBrush}" CornerRadius="14" Padding="10,5" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Salas: " FontSize="12" Foreground="#0369A1" />
                            <TextBlock Text="{Binding CantidadSalas}" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource HospitalSuccessSoftBrush}" CornerRadius="14" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Médicos: " FontSize="12" Foreground="#047857" />
                            <TextBlock Text="{Binding MedicosDelDiaCount}" FontSize="12" FontWeight="Bold" Foreground="#047857" />
                        </StackPanel>
                    </Border>

                    <!-- Indicador Pulsante de Estado MySQL -->
                    <Border Background="{Binding FondoBadgeMySql}" CornerRadius="14" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MySqlPulseDot" Width="8" Height="8" Fill="{Binding ColorPuntoMySql}" Margin="0,0,6,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.35" Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="{Binding EtiquetaMySqlNavbar}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HospitalTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Button
                        Style="{StaticResource HospitalSecondaryButtonStyle}"
                        Command="{Binding ActualizarManualCommand}"
                        ToolTip="Sincronizar datos desde el repositorio">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync20" Margin="0,0,4,0" />
                            <TextBlock Text="Refrescar" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra de Carga + Banner Animado de Feedback Visual -->
        <StackPanel Grid.Row="2" Margin="18,10,18,0">
            <ProgressBar
                Height="4"
                Margin="0,0,0,8"
                IsIndeterminate="True"
                Foreground="{StaticResource HospitalPrimaryBrush}"
                Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}" />

            <Border
                x:Name="FeedbackBanner"
                Visibility="{Binding FeedbackVisible, Converter={StaticResource BoolToVis}}"
                Background="{Binding FeedbackFondoBrush}"
                BorderBrush="{Binding FeedbackBordeBrush}"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="14,10">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FeedbackSlideTransform" Y="0" />
                </Border.RenderTransform>
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource HospitalSecondaryButtonStyle}"
                        Padding="8,2"
                        Command="{Binding CerrarFeedbackCommand}"
                        Content="✕" />
                    <TextBlock
                        DockPanel.Dock="Right"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Opacity="0.7"
                        Foreground="{Binding FeedbackTextoBrush}"
                        Text="{Binding FeedbackHora}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="HeartPulse20" Margin="0,0,10,0" Foreground="{Binding FeedbackBordeBrush}" />
                        <TextBlock
                            Text="{Binding FeedbackTitulo}"
                            FontWeight="Bold"
                            Foreground="{Binding FeedbackTextoBrush}"
                            Margin="0,0,8,0" />
                        <TextBlock
                            Text="{Binding FeedbackDetalle}"
                            Foreground="{Binding FeedbackTextoBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Contenedor Principal con Animación Suave al Cambiar de Pestaña -->
        <Grid x:Name="ActiveViewContainer" Grid.Row="3" Margin="18,12,18,10">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ViewSlideTransform" Y="0" />
            </Grid.RenderTransform>
            <views:ResumenView Visibility="{Binding EsVistaResumen, Converter={StaticResource BoolToVis}}" />
            <views:PacientesView Visibility="{Binding EsVistaPacientes, Converter={StaticResource BoolToVis}}" />
            <views:MedicosView Visibility="{Binding EsVistaMedicos, Converter={StaticResource BoolToVis}}" />
            <views:LaboratoriosView Visibility="{Binding EsVistaLaboratorios, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Pie de Estado Clínico -->
        <Border
            Grid.Row="4"
            Background="{StaticResource HospitalNavbarBrush}"
            BorderBrush="{StaticResource HospitalBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="18,7">
            <DockPanel>
                <TextBlock
                    Text="{Binding MensajeEstado}"
                    FontSize="12"
                    Foreground="{StaticResource HospitalTextMutedBrush}" />
                <TextBlock
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource HospitalPrimaryBrush}"
                    Text="{Binding OrigenDatosTexto}" />
                <Border
                    DockPanel.Dock="Right"
                    Background="{StaticResource HospitalWarningSoftBrush}"
                    CornerRadius="8"
                    Padding="8,2"
                    Margin="12,0">
                    <TextBlock
                        Text="SOLO DATOS FICTICIOS (DEMO)"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{StaticResource HospitalWarningBrush}" />
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
