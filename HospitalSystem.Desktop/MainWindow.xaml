<ui:FluentWindow
    x:Class="HospitalSystem.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:HospitalSystem.Desktop.Views"
    Title="HospitalSystem — Gestión Clínica y Pruebas MySQL"
    Width="1380"
    Height="845"
    MinWidth="1120"
    MinHeight="700"
    Background="{DynamicResource HospitalBgBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource HospitalBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de Título Nativa -->
        <ui:TitleBar
            Grid.Row="0"
            Title="Hospital Central Metropolitano San Lucas — Sistema Clínico (.NET 10 · C# 14 · MySQL)" />

        <!-- NAVBAR HOSPITALARIO SUPERIOR -->
        <Border
            Grid.Row="1"
            Background="{DynamicResource HospitalNavbarBrush}"
            BorderBrush="{DynamicResource HospitalBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Identidad Visual del Hospital -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border
                        Width="38"
                        Height="38"
                        CornerRadius="10"
                        Background="{StaticResource HospitalBrandGradientBrush}"
                        Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="HeartPulse24" Foreground="White" FontSize="20" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Text="HOSPITAL SAN LUCAS"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{DynamicResource HospitalTextPrimaryBrush}" />
                        <TextBlock
                            Text="Gestión Clínica &amp; MySQL Lab"
                            FontSize="11"
                            Foreground="{DynamicResource HospitalTextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Pestañas Centrales del Navbar -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <RadioButton
                        Style="{StaticResource HospitalNavTabButtonStyle}"
                        IsChecked="{Binding EsVistaResumen, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" Margin="0,0,6,0" />
                            <TextBlock Text="Resumen General" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Style="{StaticResource HospitalNavTabButtonStyle}"
                        IsChecked="{Binding EsVistaPacientes, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" Margin="0,0,6,0" />
                            <TextBlock Text="Menú Pacientes" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Style="{StaticResource HospitalNavTabButtonStyle}"
                        IsChecked="{Binding EsVistaMedicos, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Stethoscope24" Margin="0,0,6,0" />
                            <TextBlock Text="Menú Médicos" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Style="{StaticResource HospitalNavTabButtonStyle}"
                        IsChecked="{Binding EsVistaLaboratorios, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Beaker24" Margin="0,0,6,0" />
                            <TextBlock Text="Salidas a Laboratorio" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Píldoras KPI + Estado MySQL + Modo Oscuro + Refrescar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource HospitalTealSoftBrush}" CornerRadius="14" Padding="9,5" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Camas: " FontSize="12" Foreground="{DynamicResource HospitalTealBrush}" />
                            <TextBlock Text="{Binding CamasDisponibles}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource HospitalTealBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource HospitalPrimarySoftBrush}" CornerRadius="14" Padding="9,5" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Salas: " FontSize="12" Foreground="{DynamicResource HospitalPrimaryBrush}" />
                            <TextBlock Text="{Binding CantidadSalas}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource HospitalPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource HospitalSuccessSoftBrush}" CornerRadius="14" Padding="9,5" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Médicos: " FontSize="12" Foreground="{DynamicResource HospitalSuccessBrush}" />
                            <TextBlock Text="{Binding MedicosDelDiaCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource HospitalSuccessBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{Binding FondoBadgeMySql}" CornerRadius="14" Padding="9,5" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ColorPuntoMySql}" Margin="0,0,6,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.35" Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="{Binding EtiquetaMySqlNavbar}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HospitalTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Conmutador Modo Oscuro / Modo Claro -->
                    <Button
                        Margin="0,0,6,0"
                        Style="{StaticResource HospitalSecondaryButtonStyle}"
                        Command="{Binding AlternarModoOscuroCommand}"
                        ToolTip="Cambiar entre Modo Claro Clínico y Modo Oscuro">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WeatherMoon20" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding EtiquetaBotonTema}" />
                        </StackPanel>
                    </Button>

                    <Button
                        Style="{StaticResource HospitalSecondaryButtonStyle}"
                        Command="{Binding ActualizarManualCommand}"
                        ToolTip="Sincronizar datos desde el repositorio">
                        <ui:SymbolIcon Symbol="ArrowSync20" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra de Carga + Banner Animado de Feedback Visual -->
        <StackPanel Grid.Row="2" Margin="18,10,18,0">
            <ProgressBar
                Height="4"
                Margin="0,0,0,8"
                IsIndeterminate="True"
                Foreground="{DynamicResource HospitalPrimaryBrush}"
                Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}" />

            <Border
                x:Name="FeedbackBanner"
                Visibility="{Binding FeedbackVisible, Converter={StaticResource BoolToVis}}"
                Background="{Binding FeedbackFondoBrush}"
                BorderBrush="{Binding FeedbackBordeBrush}"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="14,10">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FeedbackSlideTransform" Y="0" />
                </Border.RenderTransform>
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource HospitalSecondaryButtonStyle}"
                        Padding="8,2"
                        Command="{Binding CerrarFeedbackCommand}"
                        Content="✕" />
                    <TextBlock
                        DockPanel.Dock="Right"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Opacity="0.75"
                        Foreground="{Binding FeedbackTextoBrush}"
                        Text="{Binding FeedbackHora}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="HeartPulse20" Margin="0,0,10,0" Foreground="{Binding FeedbackBordeBrush}" />
                        <TextBlock
                            Text="{Binding FeedbackTitulo}"
                            FontWeight="Bold"
                            Foreground="{Binding FeedbackTextoBrush}"
                            Margin="0,0,8,0" />
                        <TextBlock
                            Text="{Binding FeedbackDetalle}"
                            Foreground="{Binding FeedbackTextoBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Contenedor Principal de Vistas -->
        <Grid x:Name="ActiveViewContainer" Grid.Row="3" Margin="18,12,18,10">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ViewSlideTransform" Y="0" />
            </Grid.RenderTransform>
            <views:ResumenView Visibility="{Binding EsVistaResumen, Converter={StaticResource BoolToVis}}" />
            <views:PacientesView Visibility="{Binding EsVistaPacientes, Converter={StaticResource BoolToVis}}" />
            <views:MedicosView Visibility="{Binding EsVistaMedicos, Converter={StaticResource BoolToVis}}" />
            <views:LaboratoriosView Visibility="{Binding EsVistaLaboratorios, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Pie de Estado Clínico -->
        <Border
            Grid.Row="4"
            Background="{DynamicResource HospitalNavbarBrush}"
            BorderBrush="{DynamicResource HospitalBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="18,7">
            <DockPanel>
                <TextBlock
                    Text="{Binding MensajeEstado}"
                    FontSize="12"
                    Foreground="{DynamicResource HospitalTextMutedBrush}" />
                <TextBlock
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource HospitalPrimaryBrush}"
                    Text="{Binding OrigenDatosTexto}" />
                <Border
                    DockPanel.Dock="Right"
                    Background="{DynamicResource HospitalWarningSoftBrush}"
                    CornerRadius="8"
                    Padding="8,2"
                    Margin="12,0">
                    <TextBlock
                        Text="SOLO DATOS FICTICIOS (DEMO)"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{DynamicResource HospitalWarningBrush}" />
                </Border>
            </DockPanel>
        </Border>

        <!-- DIÁLOGO MODAL ANIMADO DE EXPORTACIÓN PDF Y TICKET DE SALIDA -->
        <Grid
            x:Name="ExportModalBackdrop"
            Grid.Row="0"
            Grid.RowSpan="5"
            Background="#99071320"
            Visibility="{Binding DialogoExportacionVisible, Converter={StaticResource BoolToVis}}">
            <Border
                x:Name="ExportModalCard"
                Width="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource HospitalSurfaceBrush}"
                BorderBrush="{DynamicResource HospitalPrimaryBrush}"
                BorderThickness="1.5"
                CornerRadius="16"
                RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ExportCardScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <StackPanel>
                    <!-- Cabecera con Gradiente Hospitalario (Azul Médico -> Verde Teal) -->
                    <Border Background="{StaticResource HospitalBrandGradientBrush}" CornerRadius="14,14,0,0" Padding="22,18">
                        <StackPanel HorizontalAlignment="Center">
                            <Border
                                Width="58"
                                Height="58"
                                CornerRadius="29"
                                Background="#26FFFFFF"
                                Margin="0,0,0,10"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ExportCheckScale" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <ui:SymbolIcon Symbol="CheckmarkCircle48" Foreground="White" FontSize="34" />
                            </Border>
                            <TextBlock
                                Text="{Binding ExportacionEtiquetaSuperior}"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#E0F2FE"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="{Binding ExportacionTitulo}"
                                FontSize="19"
                                FontWeight="Bold"
                                Foreground="White"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Margin="0,4,0,2" />
                        </StackPanel>
                    </Border>

                    <!-- Cuerpo del Comprobante Exportado -->
                    <StackPanel Margin="22,16,22,20">
                        <TextBlock
                            Text="{Binding ExportacionSubtitulo}"
                            FontSize="12.5"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource HospitalTextMutedBrush}"
                            Margin="0,0,0,12" />

                        <ProgressBar
                            x:Name="ExportProgressBar"
                            Height="6"
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            Foreground="{DynamicResource HospitalSuccessBrush}"
                            Margin="0,0,0,14" />

                        <Border
                            Background="{DynamicResource HospitalSubPanelBrush}"
                            BorderBrush="{DynamicResource HospitalBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,12"
                            Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Folio Oficial:" FontWeight="SemiBold" Foreground="{DynamicResource HospitalTextMutedBrush}" />
                                    <TextBlock Text="{Binding ExportacionFolio}" FontWeight="Bold" Foreground="{DynamicResource HospitalTealBrush}" HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Cédula:" FontWeight="SemiBold" Foreground="{DynamicResource HospitalTextMutedBrush}" />
                                    <TextBlock Text="{Binding ExportacionCedula}" FontWeight="Bold" Foreground="{DynamicResource HospitalTextPrimaryBrush}" HorizontalAlignment="Right" />
                                </DockPanel>
                                <TextBlock Text="{Binding ExportacionPaciente}" FontWeight="Bold" Foreground="{DynamicResource HospitalTextPrimaryBrush}" Margin="0,2,0,4" />
                                <TextBlock Text="{Binding ExportacionMedicoYCama}" FontSize="12" Foreground="{DynamicResource HospitalTextMutedBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ExportacionSintomas}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource HospitalTextPrimaryBrush}" Margin="0,0,0,8" />
                                <Border Background="{DynamicResource HospitalSuccessSoftBrush}" CornerRadius="6" Padding="8,5">
                                    <TextBlock
                                        Text="{Binding ExportacionArchivoDestino}"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource HospitalSuccessBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Button
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource HospitalPrimaryButtonStyle}"
                            Command="{Binding CerrarDialogoExportacionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark20" Margin="0,0,6,0" />
                                <TextBlock Text="Aceptar y Continuar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
